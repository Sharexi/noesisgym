// Cloudflare Workers static-assets deploy for the static export in out/.
// Cloudflare builds with `npm run build`, then deploys with `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noesisgym",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
